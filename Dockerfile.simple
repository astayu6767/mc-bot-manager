# Simple Dockerfile without Rust - for fast deploys using only JS engines (mineflayer/nmp)
# Use this if Azalea Rust build keeps failing or you don't need Azalea

FROM node:22-bookworm-slim AS base
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV DATABASE_URL=postgresql://placeholder:placeholder@127.0.0.1:5432/placeholder
RUN npm run build

FROM base AS runtime
ENV NODE_ENV=production
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY package.json package-lock.json next.config.ts tsconfig.json ./
COPY drizzle.config.ts ./
COPY src/db ./src/db
COPY start.sh ./start.sh

# Create dummy azalea binary so app doesn't crash when engine=azalea is selected
RUN echo '#!/bin/sh' > /usr/local/bin/azalea-bridge && \
    echo 'echo "{\"ev\":\"error\",\"line\":\"Azalea not built in simple image. Use mineflayer or nmp engine, or use main Dockerfile.\"}"' >> /usr/local/bin/azalea-bridge && \
    chmod +x /usr/local/bin/azalea-bridge && \
    chmod +x ./start.sh

EXPOSE 3000
CMD ["./start.sh"]
